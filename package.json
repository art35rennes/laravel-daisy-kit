{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "@art35rennes/laravel-daisy-kit",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build --config vite.file-preview-frame.config.js && vite build",
        "build:workbench-assets": "vite build --config workbench/vite.config.js",
        "build:browser-assets": "vite build --config workbench/vite.config.js --outDir ../vendor/orchestra/testbench-core/laravel/public/build",
        "test:js": "vitest run --coverage",
        "test:vite-host": "node --test tests/integration/package-source.test.mjs && node tests/integration/vite-host.mjs",
        "test:js:watch": "vitest"
    },
    "dependencies": {
        "@codemirror/autocomplete": "^6.20.3",
        "@codemirror/commands": "^6.11.0",
        "@codemirror/lang-css": "^6.3.1",
        "@codemirror/lang-html": "^6.4.12",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/lang-markdown": "^6.5.2",
        "@codemirror/lang-php": "^6.0.2",
        "@codemirror/lang-sql": "^6.10.0",
        "@codemirror/lang-yaml": "^6.1.3",
        "@codemirror/language": "^6.12.4",
        "@codemirror/search": "^6.7.2",
        "@codemirror/state": "^6.7.4",
        "@codemirror/view": "^6.43.11",
        "@dagrejs/dagre": "^3.0.0",
        "@lezer/highlight": "^1.2.3",
        "@prettier/plugin-php": "^0.25.0",
        "@tanstack/match-sorter-utils": "^8.19.4",
        "@tanstack/table-core": "^9.2.3",
        "@turf/area": "^7.3.5",
        "@turf/boolean-intersects": "^7.4.0",
        "@turf/length": "^7.3.5",
        "docx-preview": "^0.4.0",
        "leaflet": "^1.9.4",
        "leaflet-gesture-handling": "^1.2.2",
        "leaflet.markercluster": "^1.5.3",
        "pdfjs-dist": "^6.3.289",
        "prettier": "^3.9.6",
        "signature_pad": "^5.1.3",
        "sortablejs": "^1.15.7",
        "sql-formatter": "^15.8.2",
        "terra-draw": "^1.31.2",
        "terra-draw-leaflet-adapter": "^1.3.0",
        "trix": "^2.1.19"
    },
    "devDependencies": {
        "@rollup/plugin-inject": "^5.0.5",
        "@tailwindcss/vite": "^4.3.2",
        "@vitest/coverage-v8": "^4.1.10",
        "daisyui": "^5.7.22",
        "jsdom": "^30.0.1",
        "laravel-vite-plugin": "^3.1.0",
        "playwright": "^1.62.1",
        "tailwindcss": "^4.3.2",
        "vite": "^8.1.4",
        "vitest": "^4.1.10"
    }
}

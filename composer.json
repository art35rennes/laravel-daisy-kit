{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "art35rennes/laravel-daisy-kit",
    "type": "library",
    "description": "Reusable Laravel Blade UI kit built with DaisyUI and Tailwind CSS.",
    "keywords": [
        "laravel",
        "blade",
        "components",
        "daisyui",
        "tailwindcss"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "blade-ui-kit/blade-icons": "^1.10",
        "davidhsianturi/blade-bootstrap-icons": "^2.2",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0",
        "livewire/livewire": "^4.3"
    },
    "require-dev": {
        "laravel/boost": "^2.4",
        "laravel/framework": "^13.0",
        "laravel/pao": "^1.1",
        "laravel/pint": "^1.29",
        "pestphp/pest": "^4.7"
    },
    "autoload": {
        "psr-4": {
            "Art35rennes\\DaisyKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Art35rennes\\DaisyKit\\DaisyKitServiceProvider"
            ]
        }
    },
    "scripts": {
        "ai:catalog": "@php tools/generate-ai-catalog.php",
        "test": "pest",
        "lint": "pint --parallel"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

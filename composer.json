{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "art35rennes/laravel-daisy-kit",
    "description": "Focused, explicitly mounted Laravel UI modules for DaisyUI host applications.",
    "keywords": ["laravel", "blade", "daisyui", "tailwindcss", "forms", "table", "map"],
    "homepage": "https://github.com/art35rennes/laravel-daisy-kit",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/art35rennes/laravel-daisy-kit/issues",
        "source": "https://github.com/art35rennes/laravel-daisy-kit"
    },
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/framework": "^13.0",
        "laravel/pint": "^1.29",
        "livewire/livewire": "^4.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-browser": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "phpstan/extension-installer": "^1.4"
    },
    "suggest": {
        "livewire/livewire": "Required only to enhance x-daisy-kit::forms.builder with Livewire 4."
    },
    "autoload": {
        "psr-4": {
            "Art35rennes\\DaisyKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Art35rennes\\DaisyKit\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": ["@php vendor/bin/testbench package:discover --ansi"],
        "build:workbench": ["@php vendor/bin/testbench workbench:build --ansi", "npm run build:workbench-assets"],
        "lint": ["vendor/bin/pint --parallel"],
        "lint:check": ["vendor/bin/pint --parallel --test"],
        "analyse": ["vendor/bin/phpstan analyse --memory-limit=1G"],
        "test:types": ["vendor/bin/pest --ci --no-tia --exclude-group=browser --type-coverage --min=100"],
        "test:unit": ["vendor/bin/pest --ci --no-tia --parallel --exclude-group=browser"],
        "test:browser": ["npm run build:browser-assets", "vendor/bin/pest --ci --no-tia --group=browser"],
        "test:full": ["@test:unit", "@test:browser"],
        "test:tia": ["npm run build:browser-assets", "vendor/bin/pest --tia --baselined --parallel"],
        "test:tia:fresh": ["npm run build:browser-assets", "vendor/bin/pest --tia --fresh --parallel"],
        "test": ["@analyse", "@lint:check", "@test:types", "@test:full"]
    },
    "extra": {
        "laravel": {
            "providers": ["Art35rennes\\DaisyKit\\DaisyKitServiceProvider"]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
